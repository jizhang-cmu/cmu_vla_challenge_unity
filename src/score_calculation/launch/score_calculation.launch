<launch>

  <node pkg="score_calculation" exec="scoreCalculation" name="scoreCalculation" output="screen">
    <param name="ref_traj_dir" value="$(find-pkg-prefix score_calculation)/data/trajectory_q4.ply" />
    <param name="actual_traj_dir" value="$(find-pkg-prefix vehicle_simulator)/log/trajectory.txt" />
    <param name="penaltyScale" value="0.01" />
  </node>

</launch>
